{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowJs": true,
		"checkJs": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"types": ["bun"]
	},
	"include": [".lintstagedrc.js", "src/tests/**/*.ts", "skills/**/*.test.ts"],
	"exclude": ["node_modules"]
}
