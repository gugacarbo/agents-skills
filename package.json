{
	"name": "@gugacarbo/agents-skills",
	"version": "1.0.0",
	"description": "Installable coding-agent skills and their shell orchestrator.",
	"scripts": {
		"dev": "sh src/dev.sh",
		"build": "bun run build:skills && sh src/build.sh",
		"build:skills": "bun run --parallel --if-present --filter '*' build",
		"test": "bash -lc 'for test_script in src/tests/*.sh; do [ -f \"$test_script\" ] && bash \"$test_script\"; done' && bun run test:skills",
		"test:skills": "bun run --parallel --if-present --filter '*' test",
		"validate:skills": "bun run --if-present --filter '*' validate",
		"lint": "biome check .",
		"spellcheck": "cspell .",
		"format:md": "bunx prettier --write \"**/*.{md,mdx}\" --log-level=warn --no-error-on-unmatched-pattern --cache",
		"format:sh": "bunx prettier --write \"**/*.sh\" --plugin=prettier-plugin-sh --log-level=warn --no-error-on-unmatched-pattern --cache",
		"format:ts": "biome check --write .",
		"format": "bun run format:md && bun run format:ts",
		"typecheck": "tsc --noEmit",
		"knip": "knip",
		"verify": "bash scripts/verify",
		"prepare": "husky",
		"lint-staged": "lint-staged",
		"skills-check": "python3 ./scripts/skills-check"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"packageManager": "bun@1.3.11",
	"workspaces": [
		"skills/*"
	],
	"type": "module",
	"devDependencies": {
		"@biomejs/biome": "2.5.5",
		"@cspell/dict-pt-br": "^2.4.2",
		"cspell": "^10.0.1",
		"husky": "^9.1.7",
		"knip": "^6.27.0",
		"lint-staged": "^17.1.0",
		"prettier": "^3.9.5",
		"prettier-plugin-sh": "^0.19.0",
		"tsc-files": "^1.1.4",
		"typescript": "^7.0.2"
	}
}
