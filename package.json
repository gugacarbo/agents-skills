{
	"name": "@gugacarbo/agents-skills",
	"version": "1.0.0",
	"description": "Installable coding-agent skills and their shell orchestrator.",
	"scripts": {
		"dev": "sh src/dev.sh",
		"build": "sh src/build.sh",
		"test": "bash -lc 'for test_script in tests/*.sh skills/*/dev/tests.sh skills/*/tests/*.sh; do [ -f \"$test_script\" ] && bash \"$test_script\"; done'",
		"lint": "biome check .",
		"format:md": "pnpx prettier --write \"**/*.{md,mdx}\" --log-level=warn --no-error-on-unmatched-pattern  --cache",
		"format:ts": "biome check --write .",
		"format": "pnpm format:md && pnpm format:ts",
		"typecheck": "tsc --noEmit",
		"knip": "knip",
		"prepare": "husky",
		"lint-staged": "lint-staged",
		"test-staged": "test-staged"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "^11.5.0",
			"onFail": "download"
		}
	},
	"type": "module",
	"devDependencies": {
		"typescript": "^6.0.3"
	}
}
