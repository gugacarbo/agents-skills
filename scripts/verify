#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)"
REPO_ROOT="$(CDPATH='' cd -- "$SCRIPT_DIR/.." && pwd -P)"

cd "$REPO_ROOT"

run_check() {
  printf '\n\033[0;35mRunning: %s\033[0m\n' "$*"
  "$@"
}

run_check python3 scripts/docs-check
run_check pnpm skills-check
run_check pnpm knip
run_check pnpm biome check
run_check pnpm typecheck
run_check pnpm test
run_check pnpm validate:skills
run_check pnpm build
