#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)"
REPO_ROOT="$(CDPATH='' cd -- "$SCRIPT_DIR/.." && pwd -P)"

cd "$REPO_ROOT"

run_check() {
  printf '\n\033[0;35mRunning: %s\033[0m\n' "$*"
  "$@"
}

run_check python3 scripts/docs-check
run_check bun run skills-check
run_check bun run spellcheck
run_check bun run knip
run_check bunx biome check
run_check bun run typecheck
run_check bun run test
run_check bun run validate:skills
run_check bun run build
