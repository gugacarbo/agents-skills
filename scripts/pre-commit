#!/usr/bin/env bash
# Gate local do CASA Standard (STANDARD §3, ADR-0001) para repo sem remote/CI.
# Instalação, a partir da raiz do repo:
#   ln -sf ../../scripts/pre-commit .git/hooks/pre-commit
# Contornar exige ato deliberado (git commit --no-verify) — e é assim que deve ser.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/shared.sh"
ROOT="$(repo_root)"
cd "$ROOT"
detect_runner

python3 "$ROOT/scripts/docs-check"
python3 "$ROOT/scripts/skills-check"

${NODE_ENV_RUNNER} lint-staged

mapfile -t STAGED_FILES < <(git diff --cached --name-only --diff-filter=ACMRD)
RUN_REPOSITORY_TESTS=false
declare -A SKILL_TEST_DIRECTORIES=()

for staged_file in "${STAGED_FILES[@]}"; do
  case "$staged_file" in
    src/*|scripts/*|.husky/*|package.json|pnpm-lock.yaml|pnpm-workspace.yaml|.lintstagedrc.*|tsconfig*.json|*.sh)
      RUN_REPOSITORY_TESTS=true
      break
      ;;
    skills/*/*)
      skill_name="${staged_file#skills/}"
      skill_name="${skill_name%%/*}"
      skill_directory="skills/$skill_name"
      if [ -f "$skill_directory/package.json" ]; then
        SKILL_TEST_DIRECTORIES["$skill_directory"]=true
      fi
      ;;
  esac
done

if [ "$RUN_REPOSITORY_TESTS" = true ]; then
  printf '\nRunning repository tests...\n'
  ${NODE_ENV_RUNNER} test
elif [ "${#SKILL_TEST_DIRECTORIES[@]}" -gt 0 ]; then
  printf '\nRunning tests for changed skills...\n'
  while IFS= read -r skill_directory; do
    ${NODE_ENV_RUNNER} --dir "$skill_directory" test
  done < <(printf '%s\n' "${!SKILL_TEST_DIRECTORIES[@]}" | sort)
else
  printf '\nSkipping tests: no staged runtime changes.\n'
fi
printf '\nRunning TypeScript staged-file checks...\n'
${NODE_ENV_RUNNER} tsc-files
