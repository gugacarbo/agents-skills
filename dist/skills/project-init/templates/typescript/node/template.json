{
	"id": "typescript/node",
	"extends": ["typescript"],
	"description": "A TypeScript service or CLI targeting Node.js LTS.",
	"packageManager": "pnpm",
	"documents": {
		"AGENTS.md": "AGENTS.md",
		"REQUIREMENTS.md": "REQUIREMENTS.md"
	},
	"packageJson": {
		"scripts": {
			"dev": "tsx watch src/index.ts",
			"build": "tsc",
			"start": "node dist/index.js"
		}
	},
	"devDependencies": ["@types/node", "tsx"],
	"commands": {
		"typecheck": "pnpm run typecheck"
	}
}
