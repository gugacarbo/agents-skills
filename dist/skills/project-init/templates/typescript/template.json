{
	"id": "typescript",
	"extends": ["base"],
	"description": "Strict TypeScript tooling and conventions.",
	"packageManager": "pnpm",
	"documents": {
		"AGENTS.md": "AGENTS.md",
		"REQUIREMENTS.md": "REQUIREMENTS.md"
	},
	"files": [
		{ "source": "files/knip.json", "target": "knip.json" },
		{ "source": "files/tsconfig.json", "target": "tsconfig.json" },
		{ "source": "files/src/index.ts", "target": "src/index.ts" },
		{
			"source": "../_shared/tooling/files/biome.template.json",
			"target": "biome.json"
		},
		{
			"source": "../_shared/husky/files/.husky/pre-commit",
			"target": ".husky/pre-commit"
		},
		{
			"source": "../_shared/husky/files/.husky/pre-push",
			"target": ".husky/pre-push"
		},
		{
			"source": "../_shared/husky/files/scripts/pre-commit",
			"target": "scripts/pre-commit"
		},
		{
			"source": "../_shared/husky/files/scripts/pre-push",
			"target": "scripts/pre-push"
		},
		{
			"source": "../_shared/husky/files/scripts/lib/shared.sh",
			"target": "scripts/lib/shared.sh"
		}
	],
	"packageJson": {
		"name": "{{projectName}}",
		"private": true,
		"type": "module",
		"scripts": {
			"dev": "tsc --watch",
			"build": "tsc",
			"test": "vitest run --passWithNoTests",
			"lint": "biome lint .",
			"format": "biome format --write .",
			"typecheck": "tsc --noEmit",
			"knip": "knip",
			"prepare": "husky"
		}
	},
	"devDependencies": [
		"typescript",
		"vitest",
		"@biomejs/biome",
		"knip",
		"husky"
	],
	"allowedBuilds": ["esbuild"],
	"commands": {
		"setup": ["pnpm run prepare"],
		"typecheck": "pnpm run typecheck"
	},
	"optionalTools": {
		"cspell": {
			"description": "Add English and Brazilian Portuguese spell checking.",
			"devDependencies": ["cspell", "@cspell/dict-pt-br"],
			"packageJson": {
				"scripts": {
					"spellcheck": "cspell ."
				}
			},
			"files": [
				{
					"source": "../base/optional-tools/cspell/files/cspell.config.yaml",
					"target": "cspell.config.yaml"
				}
			]
		},
		"env": {
			"description": "Add a typed environment-variable contract (.env.example plus validation dependencies).",
			"devDependencies": ["@t3-oss/env-core", "zod"],
			"files": [
				{
					"source": "../_shared/optional-tools/env/files/.env.example",
					"target": ".env.example"
				}
			],
			"notes": [
				"Centralize and validate environment reads before startup (e.g. @t3-oss/env-core + zod): export typed values from a single module and consume them across the app. .env is gitignored; .env.example documents the contract."
			]
		},
		"secrets": {
			"description": "Add a local gitleaks secret-scanning gate wired into the pre-commit hook.",
			"packageJson": {
				"scripts": {
					"secrets:check": "sh scripts/gitleaks-check"
				}
			},
			"files": [
				{
					"source": "../_shared/optional-tools/secrets/files/scripts/gitleaks-check",
					"target": "scripts/gitleaks-check"
				}
			],
			"notes": [
				"gitleaks is an external binary: when missing, the gate is skipped with a warning and CI covers the whole repository. Install it to enable local scanning."
			]
		},
		"format": {
			"description": "Add Prettier-based formatting for Markdown and shell scripts alongside Biome.",
			"devDependencies": ["prettier", "prettier-plugin-sh"],
			"packageJson": {
				"scripts": {
					"format:md": "{{pmExec}} prettier --write \"**/*.{md,mdx}\" --no-error-on-unmatched-pattern --cache",
					"format:sh": "{{pmExec}} prettier --write \"**/*.sh\" --plugin=prettier-plugin-sh --no-error-on-unmatched-pattern --cache",
					"format": "biome format --write . && {{packageManager}} run format:md && {{packageManager}} run format:sh"
				}
			},
			"notes": [
				"This tool replaces the base `format` script with one that also formats Markdown and shell files via Prettier; approve the package.json#/scripts/format collision to apply."
			]
		},
		"lint-staged": {
			"description": "Format, type-check, and test only staged files before commit.",
			"devDependencies": [
				"lint-staged",
				"prettier",
				"tsc-files",
				"test-staged"
			],
			"packageJson": {
				"scripts": {
					"lint-staged": "lint-staged"
				}
			},
			"files": [
				{
					"source": "optional-tools/lint-staged/files/.lintstagedrc.js",
					"target": ".lintstagedrc.js"
				}
			],
			"notes": [
				"The pre-commit hook detects .lintstagedrc.js and runs lint-staged automatically; no separate hook script is needed."
			]
		}
	}
}
