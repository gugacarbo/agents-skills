{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://code-flow.dev/schemas/protocol-event/v1",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"event_id",
		"run_id",
		"role",
		"event",
		"state_before",
		"state_after",
		"observed_issue",
		"sources_evidence",
		"project_guidance",
		"base_head",
		"result"
	],
	"properties": {
		"event_id": { "type": "string", "minLength": 1 },
		"run_id": { "type": "string", "minLength": 1 },
		"role": {
			"enum": [
				"dispatcher",
				"architect",
				"executor",
				"code-reviewer",
				"integrator",
				"gate"
			]
		},
		"event": { "type": "string", "minLength": 1 },
		"state_before": { "type": "string" },
		"state_after": { "type": "string" },
		"observed_issue": {
			"type": "object",
			"required": ["number", "url", "labels"],
			"properties": {
				"number": { "type": "integer" },
				"url": { "type": "string" },
				"updated_at": { "type": "string" },
				"labels": { "type": "array", "items": { "type": "string" } }
			}
		},
		"sources_evidence": { "type": "array", "items": { "type": "string" } },
		"project_guidance": { "type": "array", "items": { "type": "string" } },
		"base_head": {
			"type": "object",
			"required": ["base", "head"],
			"properties": {
				"base": { "type": "string" },
				"head": { "type": "string" }
			}
		},
		"result": {
			"type": "object",
			"required": ["status", "summary"],
			"properties": {
				"status": {
					"enum": [
						"completed",
						"waiting_human",
						"blocked",
						"retryable_failure",
						"invalid_state"
					]
				},
				"summary": { "type": "string" }
			}
		},
		"gate": {
			"type": "object",
			"required": ["decision", "author"],
			"properties": {
				"decision": { "type": "string" },
				"author": { "type": "string" },
				"comment_url": { "type": "string" }
			}
		}
	}
}
