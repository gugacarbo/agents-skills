{
  "version": 1,
  "hooks": {
    "agentStop": [
      {
        "type": "command",
        "bash": "python3 __DISPATCH_SH__ --agent github-copilot --event agentStop --repo-root __REPO_ROOT_SH__ --notifier __NOTIFIER_PY_SH__",
        "powershell": "py -3 __DISPATCH_PS__ --agent github-copilot --event agentStop --repo-root __REPO_ROOT_PS__ --notifier __NOTIFIER_PS__",
        "timeoutSec": 30
      }
    ]
  }
}
