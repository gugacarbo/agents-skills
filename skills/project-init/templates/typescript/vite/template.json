{
	"id": "typescript/vite",
	"extends": ["typescript"],
	"description": "A client application generated by Vite and overlaid with complete repository tooling.",
	"packageManager": "pnpm",
	"requiresFrameworkReady": true,
	"defaultVariant": "vanilla-ts",
	"variants": {
		"vanilla-ts": {
			"frameworkName": "Vite vanilla TypeScript",
			"typecheck": "tsc --noEmit"
		},
		"react-ts": {
			"frameworkName": "Vite React",
			"typecheck": "tsc -b",
			"readiness": { "packages": ["react"] }
		},
		"vue-ts": {
			"frameworkName": "Vite Vue",
			"typecheck": "vue-tsc -b",
			"readiness": { "packages": ["vue"] }
		},
		"svelte-ts": {
			"frameworkName": "Vite Svelte",
			"typecheck": "svelte-check",
			"readiness": { "packages": ["svelte"] }
		}
	},
	"readiness": {
		"files": ["package.json"],
		"packages": ["vite"]
	},
	"omitTargets": ["tsconfig.json", "src/index.ts"],
	"omitPackageJson": ["/scripts/dev", "/scripts/build"],
	"documents": {
		"AGENTS.md": "AGENTS.md",
		"REQUIREMENTS.md": "REQUIREMENTS.md"
	},
	"commands": {
		"framework": "pnpm create vite {{targetArg}} --template {{variantArg}}",
		"frameworkCwd": "{{targetParent}}",
		"typecheck": "{{typecheckCommand}}"
	}
}
