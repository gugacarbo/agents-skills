{
	"id": "typescript/vite",
	"extends": ["typescript"],
	"description": "A client application generated by Vite and overlaid with repository conventions.",
	"packageManager": "pnpm",
	"requiresFrameworkReady": true,
	"defaultVariant": "vanilla-ts",
	"variants": {
		"vanilla-ts": {
			"frameworkName": "Vite vanilla TypeScript",
			"typecheck": "tsc --noEmit"
		},
		"react-ts": { "frameworkName": "Vite React", "typecheck": "tsc --noEmit" },
		"vue-ts": { "frameworkName": "Vite Vue", "typecheck": "vue-tsc --noEmit" },
		"svelte-ts": { "frameworkName": "Vite Svelte", "typecheck": "svelte-check" }
	},
	"documents": {
		"AGENTS.md": "AGENTS.md",
		"REQUIREMENTS.md": "REQUIREMENTS.md"
	},
	"commands": {
		"framework": "pnpm create vite . --template {{variant}}",
		"frameworkCwd": "{{targetName}}",
		"install": ["pnpm add -D vitest @biomejs/biome knip husky"],
		"setup": ["pnpm exec biome init", "pnpm exec husky init"],
		"typecheck": "{{typecheckCommand}}"
	}
}
