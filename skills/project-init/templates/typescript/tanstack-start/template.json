{
	"id": "typescript/tanstack-start",
	"extends": ["typescript"],
	"description": "A full-stack React application with TanStack Start, SSR, file routing, and complete repository tooling.",
	"packageManager": "pnpm",
	"frameworkName": "TanStack Start React",
	"requiresFrameworkReady": true,
	"readiness": {
		"files": ["package.json"],
		"packages": ["@tanstack/react-start"]
	},
	"omitTargets": ["tsconfig.json", "src/index.ts", "biome.json"],
	"omitPackageJson": ["/scripts/dev", "/scripts/build", "/scripts/lint"],
	"removePackageJson": ["/pnpm/onlyBuiltDependencies"],
	"planNotes": [
		"TanStack Start is a full-stack React framework with server-side rendering built on Vite.",
		"Treat src/routeTree.gen.ts as generated code: do not edit it and exclude it from dead-code enforcement."
	],
	"documents": {
		"AGENTS.md": "AGENTS.md",
		"REQUIREMENTS.md": "REQUIREMENTS.md"
	},
	"files": [
		{ "source": "files/knip.json", "target": "knip.json" },
		{
			"source": "../vite/files/vitest.config.ts",
			"target": "vitest.config.ts"
		}
	],
	"packageJson": {
		"scripts": {
			"test": "vitest run --config vitest.config.ts --passWithNoTests"
		}
	},
	"allowedBuilds": ["lightningcss"],
	"commands": {
		"framework": "pnpm dlx @tanstack/cli@latest create {{targetArg}} --package-manager pnpm --toolchain biome --no-examples --no-intent --yes",
		"frameworkCwd": "{{targetParent}}",
		"setup": ["pnpm exec biome migrate --write", "pnpm run prepare"],
		"typecheck": "pnpm run typecheck"
	}
}
