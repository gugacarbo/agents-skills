{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://code-flow.dev/schemas/worker-result/v1",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"run_id",
		"role",
		"status",
		"confirmed_state",
		"summary",
		"artifacts"
	],
	"properties": {
		"run_id": { "type": "string", "minLength": 1 },
		"role": { "type": "string" },
		"status": {
			"enum": [
				"completed",
				"waiting_human",
				"blocked",
				"retryable_failure",
				"invalid_state"
			]
		},
		"confirmed_state": { "type": ["string", "null"] },
		"summary": { "type": "string" },
		"artifacts": { "type": "array", "items": { "type": "string" } },
		"event_id": { "type": "string" }
	}
}
