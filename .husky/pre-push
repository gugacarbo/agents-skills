#!/usr/bin/env sh

 echo "\033[0;35mRunning pre-push checks...\033[0m"

# Bloqueia push cujo destino no remoto é branch de produção (main/master).
# Cobre: git push origin main, git push origin feature:main, git push origin :main, etc.
# Não cobre: git push --no-verify (use branch protection no GitHub).

should_blocked=0

if [ "$should_blocked" -eq 1 ]; then

  blocked=0


  while read -r local_ref local_sha remote_ref remote_sha; do
    case "$remote_ref" in
      refs/heads/*)
        remote_branch="${remote_ref#refs/heads/}"
        remote_branch_lower=$(printf '%s' "$remote_branch" | tr '[:upper:]' '[:lower:]')
        case "$remote_branch_lower" in
          main | master)
            blocked=1
            printf '\n'
            printf '\033[1;31m✖ Push para a branch %s está bloqueado\033[0m\n' "$remote_branch"
            if [ -n "$local_ref" ]; then
              local_branch="${local_ref#refs/heads/}"
              printf '\033[0m   Refspec: %s → %s\033[0m\n' "$local_branch" "$remote_branch"
            elif [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
              printf '\033[0m   Refspec: (delete) → %s\033[0m\n' "$remote_branch"
            fi
            printf '\033[1;33m↳ Faça push para staging (ex.: git push origin HEAD:staging).\033[0m\n'
            #! printf '\033[0;90m   --no-verify ignora este hook; proteja main no remoto também.\033[0m\n'
            printf '\n'
            ;;
        esac
        ;;
    esac
  done

  if [ "$blocked" -eq 1 ]; then
    exit 1
  fi

fi


# `dist/` is deliberately ignored to keep generated files out of normal Git
# workflows, but it is the versioned payload consumed by the installer.
# A pre-push hook cannot add a newly created commit to the push that triggered
# it: Git already calculated the refspec. Commit the regenerated artifact and
# ask for a second push so the remote always receives that commit.
if git status --porcelain=v1 --untracked-files=all -- . ':(exclude)dist' | grep -q .; then
  printf '\033[1;31m✖ Ha alteracoes nao commitadas fora de dist/.\033[0m\n'
  printf '\033[1;33m↳ Commit ou descarte-as antes do push; dist/ nao sera gerado a partir de fontes sujas.\033[0m\n'
  exit 1
fi

pnpm verify

git add -f dist/

if ! git diff --cached --quiet -- dist/; then
  AGENTS_SKILLS_GENERATED_ARTIFACT_COMMIT=1 git commit --only -m "build(skills): regenerate published skills" -- dist/
  printf '\033[1;33m↳ dist/ foi regenerado e commitado. Execute git push novamente para envia-lo.\033[0m\n'
  exit 1
fi
