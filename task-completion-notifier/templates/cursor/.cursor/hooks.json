{
  "version": 1,
  "hooks": {
    "stop": [
      {
        "command": "python3 __RUNTIME_ROOT__/.task-completion-notifier/scripts/hook-dispatch.py --agent cursor --event stop --state-dir __RUNTIME_ROOT__/.task-completion-notifier/state --notifier __RUNTIME_ROOT__/.task-completion-notifier/scripts/notify.sh"
      }
    ]
  }
}
